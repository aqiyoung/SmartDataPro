# ===========================================
# SmartDataPro 环境变量配置
# 复制此文件为 .env 并修改对应的值
# ===========================================

# --- 日志级别 (DEBUG/INFO/WARNING/ERROR) ---
LOG_LEVEL=INFO

# --- CORS 允许的域名（逗号分隔）---
CORS_ORIGINS=http://localhost:5180,http://localhost

# --- 后端服务 ---
HOST=0.0.0.0
PORT=8016
WORKERS=1

# --- 调试模式 (0=关闭, 1=开启) ---
DEBUG=0

# --- API 文档 ---
DOCS_URL=/docs
OPENAPI_URL=/openapi.json
